---
interface Props {
  heading: string;
  id: string;
}

const { heading, id } = Astro.props;
---

<section class="page-section" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="page-section__heading">{heading}</h2>
  <div class="page-section__body">
    <slot />
  </div>
</section>

<style>
  .page-section {
    max-width: 65ch;
    margin-bottom: var(--space-8);
  }

  .page-section__heading {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: lowercase;
    margin-bottom: var(--space-4);
  }

  .page-section__body :global(p) {
    font-size: var(--fs-3);
    color: var(--muted);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .page-section__body :global(p + p) {
    margin-top: var(--space-4);
  }

  .page-section__body :global(ul),
  .page-section__body :global(ol) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .page-section__body :global(li) {
    font-size: var(--fs-3);
    color: var(--muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .page-section__body :global(h3) {
    font-size: var(--fs-4);
    color: var(--text);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .page-section__body :global(.text-link) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 0.2em;
    transition: color var(--dur) var(--ease);
  }

  .page-section__body :global(.text-link:hover) {
    color: var(--accent-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-section__body :global(.text-link) {
      transition: none;
    }
  }
</style>
