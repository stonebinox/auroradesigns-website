---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="cta-link" href={href}>{label}</a>

<style>
  .cta-link {
    --cta-ring-inner: 2px;
    --cta-ring-outer: 5px;
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease);
  }

  .cta-link:hover {
    background: var(--accent-dim);
  }

  .cta-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--cta-ring-inner) var(--bg), 0 0 0 var(--cta-ring-outer) var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-link {
      transition: none;
    }
  }
</style>
