---
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__inner">
      <div class="site-footer__legal">
        <span class="site-footer__name">{site.legalName}</span>
        <span class="site-footer__year site-footer__muted">&copy; {year}</span>
      </div>

      <div class="site-footer__contact">
        <a href={`mailto:${site.email}`} class="site-footer__link">
          {site.email}
        </a>
        <a href={site.phone.href} class="site-footer__link site-footer__muted">
          {site.phone.display}
        </a>
        <span class="site-footer__location site-footer__muted">{site.location}</span>
      </div>

    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    padding-block: var(--space-8);
    border-top: var(--border-width) solid var(--border);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .site-footer__legal {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .site-footer__name {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--text);
  }

  .site-footer__year {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__link {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .site-footer__link:hover {
    color: var(--accent);
  }

  .site-footer__location {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
  }

  .site-footer__muted {
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .site-footer__contact {
      align-items: flex-end;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__link {
      transition: none;
    }
  }
</style>
