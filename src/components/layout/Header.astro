---
import { site } from '../../data/site';
import { navigation } from '../../data/navigation';
---

<header class="site-header" role="banner">
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="site-nav__brand" aria-label=`${site.brand} home`>
      <img src="/aurora-logo.png" alt={site.brand} class="site-nav__brand-logo" width="1130" height="603" />
    </a>

    <!-- Desktop nav -->
    <ul class="site-nav__links" role="list">
      {navigation.map((item) => (
        <li>
          <a href={item.href} class="site-nav__link">{item.label}</a>
        </li>
      ))}
    </ul>

    <a href="/#contact" class="site-nav__cta">Start an engagement</a>

    <!-- Mobile menu (keyboard-operable, no JS) -->
    <details class="site-nav__mobile-menu">
      <summary class="site-nav__mobile-toggle" aria-label="Open navigation menu">
        <span class="site-nav__hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <div class="site-nav__mobile-panel">
        <ul role="list">
          {navigation.map((item) => (
            <li>
              <a href={item.href} class="site-nav__mobile-link">{item.label}</a>
            </li>
          ))}
          <li>
            <a href="/#contact" class="site-nav__mobile-link site-nav__mobile-link--cta">
              Start an engagement
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--border-width) solid var(--border);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: var(--space-8);
  }

  .site-nav__brand {
    font-family: var(--font-mono);
    font-size: var(--fs-3);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }

  .site-nav__brand-logo {
    height: 2.25rem;
    width: auto;
    display: block;
  }

  .site-nav__brand:hover {
    color: var(--accent);
    transition: color var(--dur) var(--ease);
  }

  .site-nav__links {
    display: none;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
  }

  .site-nav__link {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--text);
  }

  .site-nav__cta {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--accent);
    text-decoration: none;
    border: var(--border-width) solid var(--accent);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .site-nav__cta:hover {
    background-color: var(--accent);
    color: var(--bg);
  }

  /* Mobile menu */
  .site-nav__mobile-menu {
    margin-left: auto;
  }

  .site-nav__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    border-radius: var(--radius);
    list-style: none;
    color: var(--text);
  }

  .site-nav__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .site-nav__hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .site-nav__hamburger span {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--text);
    transition: background-color var(--dur) var(--ease);
  }

  .site-nav__mobile-panel {
    position: absolute;
    top: var(--space-8);
    left: 0;
    right: 0;
    background-color: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
    padding: var(--space-4) var(--gutter) var(--space-6);
  }

  .site-nav__mobile-panel ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
  }

  .site-nav__mobile-link {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-3);
    color: var(--muted);
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: var(--border-width) solid var(--border);
    transition: color var(--dur) var(--ease);
  }

  .site-nav__mobile-link:hover {
    color: var(--text);
  }

  .site-nav__mobile-link--cta {
    color: var(--accent);
    border-bottom: none;
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .site-nav__links {
      display: flex;
    }

    .site-nav__cta {
      display: block;
    }

    .site-nav__mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__link,
    .site-nav__cta,
    .site-nav__mobile-link,
    .site-nav__hamburger span {
      transition: none;
    }
  }
</style>
