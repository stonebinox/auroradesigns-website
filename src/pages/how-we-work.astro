---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/ui/PageShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CtaLink from '../components/ui/CtaLink.astro';
import { howWeWork } from '../data/how-we-work';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/seo';

const pageUrl = absoluteUrl('/how-we-work/');
const crumbs = [
  { name: site.brand, url: `${site.url}/` },
  { name: howWeWork.breadcrumb, url: pageUrl },
];
---

<BaseLayout title={howWeWork.title} description={howWeWork.answer} crumbs={crumbs}>
  <PageShell>
    <PageHeader label={howWeWork.breadcrumb} title={howWeWork.heading} answer={howWeWork.answer} />

    <ol class="steps">
      {howWeWork.steps.map((step) => (
        <li class="step">
          <p class="step__label">{step.index}</p>
          <h2 class="step__title">{step.title}</h2>
          <p class="step__desc">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="closing">
      <p class="closing__line">{howWeWork.closing}</p>
      <CtaLink href={howWeWork.cta.href} label={howWeWork.cta.label} />
    </div>
  </PageShell>
</BaseLayout>

<style>
  .steps {
    max-width: 65ch;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: var(--border-width) solid var(--border);
    padding-block: var(--space-6);
  }

  .step__label {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .step__title {
    font-size: var(--fs-5);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .step__desc {
    font-size: var(--fs-3);
    color: var(--muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .closing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 65ch;
    border-top: var(--border-width) solid var(--border);
    padding-top: var(--space-7);
  }

  .closing__line {
    font-family: var(--font-display);
    font-size: var(--fs-5);
    color: var(--text);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
</style>
