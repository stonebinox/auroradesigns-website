---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/ui/PageShell.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageSection from '../components/ui/PageSection.astro';
import { aboutPage } from '../data/pages';
import { site } from '../data/site';
import { joinNames } from '../lib/format';
import { absoluteUrl } from '../lib/seo';

const products = (await getCollection('products')).sort((a, b) =>
  a.data.order !== b.data.order ? a.data.order - b.data.order : a.data.name.localeCompare(b.data.name),
);

const pageUrl = absoluteUrl('/about/');
const crumbs = [
  { name: site.brand, url: `${site.url}/` },
  { name: aboutPage.breadcrumb, url: pageUrl },
];
const countryNames = site.countries.map((c) => (aboutPage.countriesWithArticle.includes(c) ? `the ${c}` : c));
const where = `${aboutPage.locationPrefix} ${joinNames(countryNames)}.`;
---

<BaseLayout
  title={aboutPage.title}
  description={aboutPage.answer}
  crumbs={crumbs}
  page={{ pageType: ['WebPage', 'AboutPage'] }}
>
  <PageShell>
    <PageHeader label={aboutPage.breadcrumb} title={aboutPage.heading} answer={aboutPage.answer} />

    <PageSection id="beliefs" heading={aboutPage.beliefsHeading}>
      <ul>
        {aboutPage.beliefs.map((line) => <li><span class="belief">{line}</span></li>)}
      </ul>
    </PageSection>

    <PageSection id="founders" heading={aboutPage.foundersHeading}>
      <ul>
        {site.founders.map((f) => (
          <li>
            <h3>{f.name}</h3>
            <p>
              {f.jobTitle}.{f.summary ? ` ${f.summary}` : ''}
              {f.sameAs[0] && (
                <>
                  {' '}
                  <a class="text-link" href={f.sameAs[0]} target="_blank" rel="noopener noreferrer">{aboutPage.linkedinLabel}</a>
                </>
              )}
            </p>
          </li>
        ))}
      </ul>
    </PageSection>

    <PageSection id="products" heading={aboutPage.productsHeading}>
      <ul>
        {products.map((p) => (
          <li>
            <h3>{p.data.name}</h3>
            <p>{p.data.tagline}</p>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </PageSection>

    <PageSection id="where" heading={aboutPage.locationHeading}>
      <p>{where}</p>
    </PageSection>
  </PageShell>
</BaseLayout>

<style>
  .belief {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-5);
    color: var(--text);
    line-height: 1.3;
  }
</style>
