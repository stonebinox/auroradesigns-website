---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { hero } from '../data/hero';
import { howWeWork } from '../data/how-we-work';
import { sections } from '../data/sections';
import { site } from '../data/site';

const allWork = await getCollection('work');
const work = allWork.sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.data.title.localeCompare(b.data.title);
});

const allProducts = await getCollection('products');
const products = allProducts.sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.data.name.localeCompare(b.data.name);
});

function statusLabel(status: 'live' | 'building' | 'private'): string {
  if (status === 'live') return 'Live';
  if (status === 'building') return 'Building';
  return 'Private';
}
---

<BaseLayout
  title="Aurora Designs"
  description="Aurora Designs is a software architecture and engineering consultancy that embeds forward-deployed engineers with client teams."
>
  <!-- Hero region -->
  <section class="hero" aria-labelledby="hero-heading">
    <Container>
      <div class="hero__content" data-reveal>
        <p class="hero__eyebrow">{hero.eyebrow}</p>
        <div class="hero__heading-wrap">
          <h1 id="hero-heading" class="hero__heading">{hero.headline}</h1>
        </div>
        <p class="hero__summary">{hero.subheadline}</p>
        <a class="hero__cta" href={hero.cta.href}>{hero.cta.label}</a>
      </div>
    </Container>
  </section>

  <!-- How we work -->
  <section id="how-we-work" aria-labelledby="how-we-work-heading">
    <Container>
      <SectionHeading index="01" label="how we work">
        <h2 id="how-we-work-heading">{howWeWork.heading}</h2>
      </SectionHeading>
      <ol class="hww__steps">
        {howWeWork.steps.map((step) => (
          <li class="hww__step" data-reveal>
            <p class="hww__label">{step.index} / {step.label}</p>
            <h3 class="hww__title">{step.title}</h3>
            <p class="hww__desc">{step.description}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <!-- Selected work -->
  <section id="work" aria-labelledby="work-heading">
    <Container>
      <SectionHeading index="02" label="selected work">
        <h2 id="work-heading">{sections.work.heading}</h2>
      </SectionHeading>
      {work.length > 0 ? (
        <div class:list={['work-grid', { 'work-grid--multi': work.length >= 2 }]}>
          {work.map((entry) => (
            <article
              class:list={['work-card', { 'work-card--featured': entry.data.featured }]}
              data-reveal
            >
              <a href={`/work/${entry.id}`} class="work-card__link">
                <p class="work-card__meta">
                  {entry.data.client} · {entry.data.industry} · {entry.data.year}
                </p>
                <h3 class="work-card__title">{entry.data.title}</h3>
                <p class="work-card__summary">{entry.data.summary}</p>
                <ul class="work-card__stack" aria-label="Technology stack" role="list">
                  {entry.data.stack.map((tech) => (
                    <li class="work-card__chip">{tech}</li>
                  ))}
                </ul>
                {entry.data.metrics && entry.data.metrics.length > 0 && (
                  <dl class="work-card__metrics">
                    {entry.data.metrics.map((metric) => (
                      <div class="work-card__metric">
                        <dt class="work-card__metric-label">{metric.label}</dt>
                        <dd class="work-card__metric-value">{metric.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="work-empty">{sections.work.empty}</p>
      )}
    </Container>
  </section>

  <!-- Products -->
  <section id="products" aria-labelledby="products-heading">
    <Container>
      <SectionHeading index="03" label="products">
        <h2 id="products-heading">{sections.products.heading}</h2>
      </SectionHeading>
      {products.length > 0 ? (
        <div class="products-grid">
          {products.map((p) => (
            <article class="product-card" data-reveal>
              <div class="product-card__header">
                <h3 class="product-card__name">{p.data.name}</h3>
                <span class="product-card__status" data-status={p.data.status}>{statusLabel(p.data.status)}</span>
              </div>
              <p class="product-card__tagline">{p.data.tagline}</p>
              <p class="product-card__summary">{p.data.summary}</p>
              <ul class="product-card__stack" aria-label="Technology stack" role="list">
                {p.data.stack.map((s) => <li class="product-card__chip">{s}</li>)}
              </ul>
              {p.data.url && (
                <a
                  class="product-card__link"
                  href={p.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit {p.data.name} ↗
                </a>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="products-empty">{sections.products.empty}</p>
      )}
    </Container>
  </section>

  <!-- Contact -->
  <section id="contact" aria-labelledby="contact-heading">
    <Container>
      <SectionHeading index="04" label="contact">
        <h2 id="contact-heading">{sections.contact.heading}</h2>
      </SectionHeading>
      <div class="contact__content" data-reveal>
        <p class="contact__body">{sections.contact.body}</p>
        <ul class="contact__links">
          <li><a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="contact__phone" href={site.phone.href}>{site.phone.display}</a></li>
          <li><span class="contact__location">{site.location}</span></li>
        </ul>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* ─── Hero section ─── */
  .hero {
    --hero-bloom-w: 18rem;
    --hero-bloom-h: 12rem;
    --hero-bloom-blur: 40px;
    --hero-cta-ring-inner: 2px;
    --hero-cta-ring-outer: 5px;
    --hero-reveal-dur: 600ms;
    --hero-bloom-travel: clamp(6rem, 30vw, 22rem);
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-10);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
    width: 100%;
  }

  /* Eyebrow */
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    min-width: 0;
  }

  /* Heading wrap — contains the accent bloom behind the heading */
  .hero__heading-wrap {
    position: relative;
    isolation: isolate;
    min-width: 0;
    width: 100%;
  }

  .hero__heading-wrap::before {
    content: '';
    position: absolute;
    top: calc(var(--space-6) * -1);
    left: calc(var(--space-6) * -1);
    width: var(--hero-bloom-w);
    height: var(--hero-bloom-h);
    background: radial-gradient(
      ellipse at 30% 40%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
    filter: blur(var(--hero-bloom-blur));
    pointer-events: none;
    z-index: -1;
  }

  @keyframes hero-bloom-sweep {
    from { transform: translateX(0); }
    to   { transform: translateX(var(--hero-bloom-travel)); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__heading-wrap::before {
      animation: hero-bloom-sweep 9s ease-in-out infinite alternate;
      will-change: transform;
    }
  }

  /* Heading */
  .hero__heading {
    font-size: var(--fs-8);
    max-width: 20ch;
    overflow-wrap: anywhere;
  }

  /* Summary */
  .hero__summary {
    font-size: var(--fs-4);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.65;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  /* CTA — accent filled, mono label */
  .hero__cta {
    display: inline-block;
    align-self: flex-start;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease);
  }

  .hero__cta:hover {
    background: var(--accent-dim);
  }

  /* Override global focus ring for accent button — use bg gap so ring is visible */
  .hero__cta:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--hero-cta-ring-inner) var(--bg), 0 0 0 var(--hero-cta-ring-outer) var(--accent);
    border-radius: var(--radius);
  }

  /* ─── Scroll reveal — progressive enhancement only ─── */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] {
      opacity: 0;
      transform: translateY(var(--space-2));
      transition: opacity var(--hero-reveal-dur) var(--ease), transform var(--hero-reveal-dur) var(--ease);
    }

    :global(.js) [data-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }
  }

  /* ─── How we work section ─── */
  #how-we-work {
    --hero-reveal-dur: 600ms;
  }

  #how-we-work h2 {
    font-family: var(--font-display);
    font-size: var(--fs-6);
    color: var(--text);
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }

  .hww__steps {
    --hww-label-col: 8rem;
    --hww-stagger-1: 0ms;
    --hww-stagger-2: 80ms;
    --hww-stagger-3: 160ms;
    --hww-stagger-4: 240ms;
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: var(--space-8);
  }

  .hww__step {
    border-top: var(--border-width) solid var(--border);
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hww__label {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .hww__title {
    font-family: var(--font-display);
    font-size: var(--fs-5);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .hww__desc {
    font-size: var(--fs-3);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .hww__step {
      display: grid;
      grid-template-columns: var(--hww-label-col) 1fr 1fr;
      gap: var(--space-6);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hww__step:nth-child(1) { transition-delay: var(--hww-stagger-1); }
    .hww__step:nth-child(2) { transition-delay: var(--hww-stagger-2); }
    .hww__step:nth-child(3) { transition-delay: var(--hww-stagger-3); }
    .hww__step:nth-child(4) { transition-delay: var(--hww-stagger-4); }
  }

  /* ─── Section padding ─── */
  section[id] {
    padding-block: var(--space-9);
  }

  /* ─── Placeholder sections ─── */
  .section-placeholder {
    font-family: var(--font-display);
    font-size: var(--fs-6);
    color: var(--muted);
    margin-top: var(--space-5);
  }

  /* ─── Selected work section ─── */
  #work h2 {
    font-family: var(--font-display);
    font-size: var(--fs-6);
    color: var(--text);
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }

  .work-grid {
    --stagger-1: 0ms;
    --stagger-2: 80ms;
    --stagger-3: 160ms;
    --stagger-4: 240ms;
    --stagger-5: 320ms;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }

    .work-grid--multi .work-card--featured {
      grid-column: span 2;
    }
  }

  /* ─── Work card ─── */
  .work-card {
    --work-reveal-dur: 600ms;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      opacity var(--work-reveal-dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--work-reveal-dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-card:nth-child(1) { transition-delay: var(--stagger-1); }
    .work-card:nth-child(2) { transition-delay: var(--stagger-2); }
    .work-card:nth-child(3) { transition-delay: var(--stagger-3); }
    .work-card:nth-child(4) { transition-delay: var(--stagger-4); }
    .work-card:nth-child(5) { transition-delay: var(--stagger-5); }
  }

  /* After reveal: fast hover transitions, delay reset */
  .work-card.is-revealed {
    transition:
      border-color var(--dur) var(--ease) 0ms,
      transform var(--dur) var(--ease) 0ms,
      box-shadow var(--dur) var(--ease) 0ms;
  }

  .work-card--featured {
    --work-card-glow: color-mix(in srgb, var(--accent) 8%, transparent);
    --work-card-glow-size: 2rem;
    box-shadow: 0 0 var(--work-card-glow-size) 0 var(--work-card-glow);
  }

  .work-card:hover,
  .work-card:focus-within {
    border-color: var(--accent);
    transform: translateY(calc(var(--space-1) * -1));
  }

  .work-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .work-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    height: 100%;
  }

  .work-card__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .work-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-5);
    color: var(--text);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .work-card__summary {
    font-size: var(--fs-3);
    color: var(--muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
    flex: 1;
  }

  .work-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .work-card__chip {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    color: var(--muted);
    background: var(--bg);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  .work-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }

  .work-card__metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .work-card__metric-value {
    font-family: var(--font-mono);
    font-size: var(--fs-4);
    color: var(--accent);
  }

  .work-card__metric-label {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .work-empty {
    font-size: var(--fs-3);
    color: var(--muted);
    margin-top: var(--space-6);
  }

  /* ─── Products section ─── */
  #products h2 {
    font-family: var(--font-display);
    font-size: var(--fs-6);
    color: var(--text);
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }

  .products-grid {
    --pstagger-1: 0ms;
    --pstagger-2: 80ms;
    --pstagger-3: 160ms;
    --pstagger-4: 240ms;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ─── Product card ─── */
  .product-card {
    --product-reveal-dur: 600ms;
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      opacity var(--product-reveal-dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--product-reveal-dur) var(--ease);
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-card:nth-child(1) { transition-delay: var(--pstagger-1); }
    .product-card:nth-child(2) { transition-delay: var(--pstagger-2); }
    .product-card:nth-child(3) { transition-delay: var(--pstagger-3); }
    .product-card:nth-child(4) { transition-delay: var(--pstagger-4); }
  }

  .product-card.is-revealed {
    transition:
      border-color var(--dur) var(--ease) 0ms,
      transform var(--dur) var(--ease) 0ms;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: var(--accent);
    transform: translateY(calc(var(--space-1) * -1));
  }

  .product-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Header: name + status badge side by side */
  .product-card__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .product-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-5);
    color: var(--text);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  /* Status badge — text label is authoritative; color is supplementary */
  .product-card__status {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    border: var(--border-width) solid var(--border);
    color: var(--muted);
    background: var(--bg);
    white-space: nowrap;
  }

  .product-card__status[data-status="live"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .product-card__tagline {
    font-size: var(--fs-3);
    color: var(--text);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .product-card__summary {
    font-size: var(--fs-3);
    color: var(--muted);
    line-height: 1.65;
    max-width: 60ch;
    overflow-wrap: anywhere;
    flex: 1;
  }

  /* Stack chips */
  .product-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-card__chip {
    font-family: var(--font-mono);
    font-size: var(--fs-1);
    color: var(--muted);
    background: var(--bg);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  /* External link */
  .product-card__link {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--accent);
    align-self: flex-start;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .product-card__link:hover {
    color: var(--accent-dim);
  }

  .product-card__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .products-empty {
    font-size: var(--fs-3);
    color: var(--muted);
    margin-top: var(--space-6);
  }

  /* ─── Contact section ─── */
  #contact {
    --contact-reveal-dur: 600ms;
    --hero-reveal-dur: var(--contact-reveal-dur);
  }

  #contact h2 {
    font-family: var(--font-display);
    font-size: var(--fs-6);
    color: var(--text);
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }

  .contact__content {
    margin-top: var(--space-8);
  }

  .contact__body {
    font-size: var(--fs-3);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .contact__links {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__email {
    font-family: var(--font-mono);
    font-size: var(--fs-4);
    color: var(--accent);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .contact__email:hover {
    color: var(--accent-dim);
  }

  .contact__email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .contact__phone {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .contact__phone:hover {
    color: var(--accent);
  }

  .contact__phone:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .contact__location {
    font-family: var(--font-mono);
    font-size: var(--fs-2);
    color: var(--muted);
  }
</style>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  }
</script>
