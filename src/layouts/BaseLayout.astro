---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';
import { buildGraph, serializeJsonLd } from '../lib/seo';
import type { Crumb, JsonLdNode, PageOptions } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  crumbs?: Crumb[];
  jsonLd?: JsonLdNode[];
  page?: PageOptions;
}

const {
  title = site.brand,
  description = site.entity,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  crumbs,
  jsonLd = [],
  page,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.url);
const pageTitle = title === site.brand ? site.brand : `${title} | ${site.brand}`;
const ogImageURL = new URL(ogImage, canonicalURL);
const pageUrl = canonicalURL.href;
const graph = buildGraph({
  pageUrl,
  name: pageTitle,
  description,
  crumbs: crumbs ?? [{ name: site.brand, url: `${site.url}/` }],
  extra: jsonLd,
  page,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalURL} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Theme -->
    <meta name="theme-color" content="#0A0A0B" />
    <meta name="color-scheme" content="dark" />

    <!-- Font preloads -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {!noindex && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(graph)} />
    )}

    <!-- JS-capability flag: set before body renders to avoid reveal flash -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
